
import pandas as pd
import matplotlib.pyplot as plt
 
df = pd.read_csv("curve_shape_features.csv")
control = df[df["Polymer"] == "None (control)"]
 
colors = {"PP": "tab:blue", "PE": "tab:orange", "PCL": "tab:green"}
 
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))
 
for polymer in ["PP", "PE", "PCL"]:
    this_polymer = df[df["Polymer"] == polymer]
    table = pd.concat([control, this_polymer]).sort_values("Concentration_pct")
 
    ax1.plot(table["Concentration_pct"], table["Arc_Diameter_ohm"],
              marker="o", label=polymer, color=colors[polymer])
    ax2.plot(table["Concentration_pct"], table["Low_Freq_Tail_Slope"],
              marker="o", label=polymer, color=colors[polymer])
 
ax1.set_title("Arc Diameter vs Concentration")
ax1.set_xlabel("Concentration (%)")
ax1.set_ylabel("Arc Diameter (ohms)")
ax1.legend()
ax1.grid(alpha=0.3)
 
ax2.set_title("Low-Freq Tail Slope vs Concentration")
ax2.set_xlabel("Concentration (%)")
ax2.set_ylabel("Tail Slope")
ax2.legend()
ax2.grid(alpha=0.3)
 
fig.tight_layout()
fig.savefig("all_polymers_curve_shape.png", dpi=150)
print("Saved all_polymers_curve_shape.png")
